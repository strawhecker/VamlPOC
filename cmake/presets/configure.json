{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (VS 2026)",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-vs2026.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-debug-shared",
      "displayName": "MSVC Debug Shared (VS 2026, VAML_BUILD_SHARED=ON)",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VAML_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "msvc-asan",
      "displayName": "MSVC Debug AddressSanitizer (VS 2026, verify-only S146 lane)",
      "inherits": "msvc-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "/fsanitize=address /Zi /Od"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (VS 2026)",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/msvc-vs2026.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug (Linux, ADR-007)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-asan",
      "displayName": "Clang Debug AddressSanitizer+LeakSanitizer (Linux, verify-only S146 lane)",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address"
      }
    },
    {
      "name": "windows-clang-debug",
      "displayName": "Clang Debug (Windows, clang-cl)",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clang.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}

<!--
  vaml_viewer sample document (S475, Sprint 11c) — the live "soup-to-nuts" demo
  for the DockPanel layout container + the selection controls.

  S470: DockPanel is a REAL re-based UIElement — the ONLY missing layout
  container (StackPanel/Grid/WrapPanel/Canvas were already REAL). A WPF-faithful
  dock-stacking panel: each child docks to an edge in document order, and the
  LAST (Fill) child takes the remaining interior slot. The Dock edge is the
  attached `DockPanel.Dock` DP (enum Dock: Left=0, Top=1, Right=2, Bottom=3,
  Fill=4; default Fill). The Int32 literal rides numeric here because the common
  VAML enum-name surface (Left/Top/Right/Bottom/Fill) maps to the Horizontal/
  VerticalAlignment/IconStretch enum VALUES, not the Dock edges — a distinct
  enum; the numeric forms are unambiguous and WPF-faithful for the dock value.

  S471: RadioButton — RadioButton.IsChecked + the honest single-parent exclusive
  group (checking one clears its sibling RadioButtons under the same parent) +
  routed Checked/Unchecked.

  S472: ComboBox — ComboBox.Items + ComboBox.SelectedIndex/SelectedItem + the
  dropdown interaction (is_open/open/select_item) + SelectionChanged.

  S473: ListBox — ListBox.Items + SelectedIndex + SelectionChanged + the
  `ListBox.ItemTemplate` property-element authoring that routes the S364 engine
  so items render authored per-item content.

  The LIVE viewer renders the DockPanel layout (Left nav + Top header + Fill
  content — the canonical dock split) + each selection control interactively.
-->
<DockPanel Margin="8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- S470: dock the Left nav column (the selection controls stack). -->
  <StackPanel DockPanel.Dock="0" Width="180" Margin="4">
    <TextBlock Text="Selection Controls" FontSize="14" Margin="2"/>
    <TextBlock Text="Pick a color:" Margin="4,8,4,2"/>
    <!-- S471: a RadioButton group — checking one clears its sibling. -->
    <RadioButton x:Name="RadioRed" RadioButton.IsChecked="1" Margin="6,2"/>
    <RadioButton x:Name="RadioGreen" RadioButton.IsChecked="0" Margin="6,2"/>
    <RadioButton x:Name="RadioBlue" RadioButton.IsChecked="0" Margin="6,2"/>
    <TextBlock Text="Choose a size:" Margin="4,10,4,2"/>
    <!-- S472: the ComboBox dropdown (Items + selection). -->
    <ComboBox x:Name="SizeCombo" ComboBox.Items="Small, Medium, Large"
              ComboBox.SelectedIndex="1" Margin="6,2"/>
    <TextBlock Text="Preferred fruit:" Margin="4,10,4,2"/>
    <!-- S473: a ListBox with an authored per-item ItemTemplate. -->
    <ListBox x:Name="FruitList" ListBox.Items="Apple, Banana, Cherry" Margin="6,2">
      <ListBox.ItemTemplate>
        <TextBlock FontSize="12"/>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>

  <!-- Sprint 11d (S486): the core display + input controls — a second
       Left-docked column hosting the full breadth. -->
  <StackPanel DockPanel.Dock="0" Width="220" Margin="4" Background="#FFE8ECF4">
    <Label Label.Content="Core Display Controls" Label.FontSize="14" Margin="2"/>
    <Separator Separator.Thickness="2" Margin="2"/>
    <Border x:Name="CardBorder" Border.BorderThickness="2,1"
            Border.CornerRadius="4" Border.Padding="4" Margin="2">
      <StackPanel>
        <Rectangle x:Name="FillRect" Width="40" Height="20"/>
        <Ellipse x:Name="Dot"/>
        <Line x:Name="Rule" Line.StrokeThickness="2" Width="60"/>
      </StackPanel>
    </Border>
    <GroupBox GroupBox.Header="Credentials" Margin="2">
      <StackPanel>
        <Label Label.Content="User"/>
        <PasswordBox x:Name="Secret" PasswordBox.Password="hunter2" Margin="2"/>
      </StackPanel>
    </GroupBox>
    <ProgressBar x:Name="Progress" ProgressBar.Value="60" ProgressBar.Maximum="100"
                 Height="14" Margin="2"/>
    <Image x:Name="Logo" Image.Source="assets/logo.png" Width="24"
           Height="24" Margin="2"/>
  </StackPanel>

  <!-- S470: dock the Top header (full remaining width, 24 tall). -->
  <TextBlock DockPanel.Dock="1" Text="VAML 11d — core display + input controls"
        FontSize="16" Margin="4" Background="#FF223344"/>

  <!-- S486: an Expander hosts the expandable content in the Fill area. -->
  <Expander x:Name="More" Expander.Header="More controls" Expander.IsExpanded="1"
            Margin="4">
    <StackPanel>
      <TextBlock Text="The live viewer renders the full Sprint 11d breadth: Label,
Border, Rectangle/Ellipse/Line shapes, Image, ProgressBar, PasswordBox,
GroupBox, Expander, Separator and a StatusBar — see the Shell chrome for the
repaint." Margin="4"/>
    </StackPanel>
  </Expander>

  <!-- S486: a StatusBar docks items to the bar's bottom edge. -->
  <StatusBar DockPanel.Dock="3" Height="22" Margin="0,4,0,0">
    <TextBlock StatusBar.Dock="0" Text="Ready"/>
    <TextBlock StatusBar.Dock="1" Text="v11d"/>
  </StatusBar>

  <!-- S470: the LAST child takes the ENTIRE remaining interior (Fill=4 default;
       WPF-faithful). -->
  <StackPanel>
    <TextBlock Text="The live viewer renders this DockPanel layout + the Left
selection controls interactively (RadioButton exclusive check, ComboBox
selection, ListBox selection) — see the Shell chrome for the repaint." Margin="8"/>
  </StackPanel>

</DockPanel>

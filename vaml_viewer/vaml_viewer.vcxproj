  <!--
    vaml_viewer (Windows) — the single official consumer app.
    CONSUMER-APP PATTERN (ADR-021): includes ONLY the PUBLIC include roots (the
    IP-hiding facade per ADR-003/ADR-011), never an internal header under
    src/<lib>/src. The scaffold's main.cpp consumes only vaml-core's version API;
    later Sprint 5a steps add the vaml-vulkan/presentation public surfaces and the
    vendored GLFW/Vulkan includes exactly as the deleted POC did.
      * vaml-core public include root   : $(ProjectDir)..\src\core\include
      * vaml-vulkan public include root : $(ProjectDir)..\src\vulkan\include
      * vaml-presentation include root  : $(ProjectDir)..\src\presentation\include
      * vaml-tools public include root  : $(ProjectDir)..\src\tools\include (S293: the VBamlReader + vamlcc surface)
      * vendored GLFW + Vulkan headers  : $(ProjectDir)..\third_party\deps\{glfw,vulkan-headers}\include
    Links (x64 only, matching the repo's msvc-debug build):
      * vaml-presentation.lib : $(ProjectDir)..\build\msvc-debug\src\presentation\vaml-presentation.lib
      * vaml-vulkan.lib       : $(ProjectDir)..\build\msvc-debug\src\vulkan\vaml-vulkan.lib
      * vaml-tools.lib        : $(ProjectDir)..\build\msvc-debug\src\tools\vaml-tools.lib (S293: VBamlReader + vamlcc)
      * vaml-core.lib         : $(ProjectDir)..\build\msvc-debug\src\core\vaml-core.lib
      * glfw3.lib             : $(ProjectDir)..\build\msvc-debug\glfw\src\glfw3.lib (vendored build)
    Vulkan entry points resolve at runtime via vulkan-1.dll (VK_NO_PROTOTYPES), so
    there is no Vulkan import library (vendor headers, no SDK).
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;VAML_APPSHELL_SIDECAR="$(IntDir)MainView.vbaml";%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- /MTd to match the CMake-built static libs (the msvc-debug preset builds the
           libs with the static CRT) — avoids LNK2038 runtime-library mismatches. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src\core\include;$(ProjectDir)..\src\vulkan\include;$(ProjectDir)..\src\presentation\include;$(ProjectDir)..\src\tools\include;$(ProjectDir)..\third_party\deps\vulkan-headers\include;$(ProjectDir)..\third_party\deps\glfw\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(ProjectDir)..\build\msvc-debug\src\presentation\vaml-presentation.lib;$(ProjectDir)..\build\msvc-debug\src\vulkan\vaml-vulkan.lib;$(ProjectDir)..\build\msvc-debug\src\tools\vaml-tools.lib;$(ProjectDir)..\build\msvc-debug\src\core\vaml-core.lib;$(ProjectDir)..\build\msvc-debug\glfw\src\glfw3.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>

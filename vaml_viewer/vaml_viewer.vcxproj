      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;VAML_APPSHELL_SIDECAR="$(IntDir)MainView.vbaml";%(PreprocessorDefinitions)</PreprocessorDefinitions>

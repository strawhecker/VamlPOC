      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src\core\include;$(ProjectDir)..\src\vulkan\include;$(ProjectDir)..\src\presentation\include;$(ProjectDir)..\src\tools\include;$(ProjectDir)..\third_party\deps\vulkan-headers\include;$(ProjectDir)..\third_party\deps\glfw\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>

  <ItemGroup>
    <!--
      S444 (dep:S443) — the vamlcc compile step for the app-shell's authored
      MainView.vaml (the MSBuild analogue of the S287/S444 CMake custom command).
      Runs the PREBUILT msvc-debug vamlcc.exe (build\msvc-debug\src\tools\vamlcc.exe)
      to compile MainView.vaml → a .vbaml SIDE-CAR + an EMBEDDED C++ twin into
      the intermediate dir. The `-\-compiled -\-app` launch opens the sidecar via
      the S444 seam (VAML_APPSHELL_SIDECAR); the embed twin is the single-exe path.
    -->
    <CustomBuild Include="MainView.vaml">
      <FileType>Document</FileType>
      <Message>vamlcc: MainView.vaml -&gt; $(IntDir)MainView.vbaml + embed twin</Message>
      <Command>..\build\msvc-debug\src\tools\vamlcc.exe "$(ProjectDir)MainView.vaml" "$(IntDir)MainView.vbaml"&#xD;&#xA;..\build\msvc-debug\src\tools\vamlcc.exe --embed "$(IntDir)MainView.vbaml" "$(IntDir)app_shell_MainView_vbaml.h" "$(IntDir)app_shell_MainView_vbaml.cpp" app_shell_MainView</Command>
      <Outputs>$(IntDir)MainView.vbaml;$(IntDir)app_shell_MainView_vbaml.h;$(IntDir)app_shell_MainView_vbaml.cpp</Outputs>
    </CustomBuild>
  </ItemGroup>
